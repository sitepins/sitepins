{
  "name": "sitepins-api",
  "version": "1.0.0",
  "author": "sitepins",
  "license": "AGPL-3.0-or-later",
  "description": "backend for sitepins",
  "main": "dist/server.js",
  "exports": {
    "./package.json": "./package.json",
    "./types": "./src/types/index.d.ts",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only ./src/server.ts",
    "start": "node ./dist/server.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "test": "vitest run",
    "format": "prettier --w ./src",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check ./src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@hocuspocus/server": "^4.7.1",
    "@ltd/j-toml": "^1.38.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@opentelemetry/api": "^1.10.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.13",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "multer-s3": "^3.0.1",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.2.1",
    "socket.io": "^4.8.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "prettier": "3.9.10",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.9",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
