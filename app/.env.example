# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Backend API URL including the /api/v1 prefix, e.g. http://localhost:4000/api/v1
NEXT_PUBLIC_BACKEND_URL=""

# internal secret for project preview (must match api/.env INTERNAL_API_SECRET)
INTERNAL_API_SECRET=""

# WebSocket URL for collaborative editing
NEXT_PUBLIC_HP_WS_URL="ws://localhost:4000/api/v1/editor/collab"
# for production: wss://api.example.com/api/v1/editor/collab

# Where "/dashboard" redirects to
NEXT_PUBLIC_DASHBOARD_HOME="/dashboard/account"

# ---------------------------------------------------------------------------
# Branding (inlined at build time: rebuild after changing)
# Colors live in src/styles/theme.css.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="Sitepins"
NEXT_PUBLIC_BRAND_URL="https://sitepins.com"
# Lowercase a-z, 0-9, -. Names the repo config folder (.sitepins/), cookies,
# storage keys and upload paths. Must match BRAND_SLUG in api/.env.
NEXT_PUBLIC_BRAND_SLUG="sitepins"

# Paths under /public or absolute URLs
NEXT_PUBLIC_BRAND_LOGO="/images/logo.svg"
NEXT_PUBLIC_BRAND_LOGO_DARK="/images/logo-white.svg"
NEXT_PUBLIC_BRAND_LOGO_ICON="/images/logo-icon.svg"
NEXT_PUBLIC_BRAND_LOGO_WIDTH="136"
NEXT_PUBLIC_BRAND_LOGO_HEIGHT="40"
# Browser tab, home screen and PWA icons. A custom one must be a square PNG,
# at least 512x512.
NEXT_PUBLIC_BRAND_FAVICON="/images/favicon.png"

# Set a link to "none" to hide it
NEXT_PUBLIC_TERMS_URL="https://sitepins.com/terms"
NEXT_PUBLIC_PRIVACY_URL="https://sitepins.com/privacy-policy"
NEXT_PUBLIC_SUPPORT_URL="https://sitepins.com/contact"
NEXT_PUBLIC_UPDATES_URL="https://updates.sitepins.com"
NEXT_PUBLIC_STATUS_URL="https://status.sitepins.com"
NEXT_PUBLIC_COMMUNITY_URL="https://discord.gg/KrpvHfqcNA"
NEXT_PUBLIC_DOCS_URL="https://docs.sitepins.com"
# Source code link shown on a rebranded instance (AGPL)
NEXT_PUBLIC_SOURCE_URL="https://github.com/sitepins/sitepins"

# ---------------------------------------------------------------------------
# Media bucket (must match api/.env S3 config)
# ---------------------------------------------------------------------------
# Public base URL of your S3-compatible bucket, e.g.
#   https://<bucket>.<region>.digitaloceanspaces.com  (DO Spaces)
#   https://<bucket>.s3.<region>.amazonaws.com          (AWS)
NEXT_PUBLIC_BUCKET_URL=""

# ---------------------------------------------------------------------------
# Git apps
# ---------------------------------------------------------------------------
# Shared by both providers: your GitHub App's slug (github.com/apps/<slug>,
# commits show as <slug>[bot]) and the author name on GitLab commits.
NEXT_PUBLIC_GIT_APP_NAME=""

# GitHub app
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_PRIVATE_KEY=""

# GitLab app
NEXT_PUBLIC_GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# AI assist (optional) — server-level key enabling free AI features for all users.
# Users can also supply their own key in the UI (BYOK).
# Providers: "groq" | "openrouter" | "openai" | "gemini" | "anthropic" | "xai"
# ---------------------------------------------------------------------------
AI_PROVIDER="groq"
AI_MODEL=""
AI_API_KEY=""

# ---------------------------------------------------------------------------
# Demo account (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_IS_DEMO=false
NEXT_PUBLIC_DEMO_EMAIL=""
NEXT_PUBLIC_DEMO_PASSWORD=""
